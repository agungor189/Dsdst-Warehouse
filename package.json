{
  "name": "dsdst-warehouse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n frontend,bff -c cyan,green \"npm:dev:frontend\" \"npm:dev:server\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 3006",
    "dev:server": "PORT=3007 tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "postbuild": "node scripts/assert-no-secret-in-build.mjs",
    "start": "node server-dist/index.js",
    "preview": "npm run start",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "5.0.3",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "tailwindcss": "4.3.3",
    "supertest": "7.1.4",
    "tsx": "4.23.13",
    "typescript": "~5.8.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
