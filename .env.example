PANEL_API_BASE_URL=http://panel-address:3000
WAREHOUSE_API_KEY=replace-with-warehouse-api-key
LABEL_RENDERER_URL=http://warehouse-label-renderer:3010
LABEL_RENDERER_API_KEY=replace-with-shared-label-api-key
COOKIE_SECURE=false
# Yalnız güvenilir reverse proxy doğrudan uygulamaya bağlanıyorsa 1 yapın.
TRUST_PROXY_HOPS=0
# Virgülle ayrılmış ek browser originleri; aynı-origin istekler otomatik kabul edilir.
ALLOWED_ORIGINS=https://warehouse.example
